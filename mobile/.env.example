# Restrict each key to its API and application before use.
# Copy this file to `.env` in this folder, then restart Expo (`npx expo start`).
#
# Native maps (custom/dev builds only — NOT read by Expo Go for Google tiles):
#   GOOGLE_MAPS_ANDROID_API_KEY / GOOGLE_MAPS_IOS_API_KEY are embedded at build time
#   and require a new native build (`npx expo run:ios|android` or EAS).
# Expo Go on iOS uses Apple Maps without keys. Expo Go on Android uses Expo's maps.
#
# Web maps (Metro web / `npm run web`):
#   EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY is public — restrict by HTTP referrer
#   (include http://localhost:8081 for local preview).

GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
EXPO_PUBLIC_WORK_API_URL=http://localhost:8082
